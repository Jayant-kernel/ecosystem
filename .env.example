# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Frontend (safe to expose in the browser; VITE_ prefix only) ---
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/prod

# --- Server-side only — NEVER prefix these with VITE_ ---
# Temporary LLM provider (gemini | bedrock). Gemini is called from the Lambda.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# ElevenLabs STT + TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Bedrock (used when LLM_PROVIDER=bedrock)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=ap-south-1

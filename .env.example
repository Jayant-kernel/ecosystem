# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Frontend (safe to expose in the browser; VITE_ prefix only) ---
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/prod

# --- Server-side only — NEVER prefix these with VITE_ ---
# LLM providers. The tutor tries LLM_PROVIDER first, then each entry of
# LLM_FALLBACK_PROVIDER in order (a comma-separated chain is allowed, e.g.
# "grok,gemini"). Values: groq | grok | gemini | bedrock, or 'none'.
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini

# Groq (primary). Key at console.groq.com.
# gpt-oss-120b is the strongest tool-calling model on Groq; gpt-oss-20b is a
# lighter, faster alternative. Both support function calling and streaming.
GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# xAI Grok (optional alternative)
GROK_API_KEY=
GROK_MODEL_ID=grok-4-fast

# Google Gemini (fallback)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# ElevenLabs STT + optional TTS fallback
# The voice id decides how the tutor sounds. Adult male options:
#   Shubh  y0IUmXZMBt1M9uXCVcPL  adult male, deep/calm/steady (Indian English)
#   Brian  nPczCjzI2devNBz1zQrb  deep, resonant, middle-aged (US)
#   Daniel onwK4e9ZLuTAKqWW03F9  steady broadcaster (UK)
#   Adam   pNInz6obpgDQGcFmaJgB  firm, middle-aged (US)
# List your own account's voices with:
#   curl -s -H "xi-api-key: $ELEVENLABS_API_KEY" https://api.elevenlabs.io/v1/voices
# One key covers speech-to-text, and can still be used for TTS if TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# TTS provider
# Use sarvam for the spoken tutor voice. ElevenLabs is still used above for STT.
TTS_PROVIDER=sarvam

# Sarvam TTS (male voice)
# Add SARVAM_API_KEY to GitHub Secrets. The other values are normal variables.
# Speakers are lowercase; shubh is Sarvam's default male Bulbul v3 voice.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE_CODE=en-IN
SARVAM_TTS_OUTPUT_AUDIO_CODEC=mp3
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_PACE=0.98
SARVAM_TTS_TEMPERATURE=0.6

# ElevenLabs TTS delivery. Lower stability + some style = more expressive (emotion);
# speed below 1 slows the tutor down. All optional; the defaults live in
# infra/src/llm-bridge/elevenlabs.mjs.
TTS_MODEL_ID=eleven_turbo_v2_5      # fastest expressive model; eleven_flash_v2_5 = faster, flatter
TTS_OUTPUT_FORMAT=mp3_44100_64      # lower bitrate = smaller payload = less latency
TTS_SPEED=0.98                      # 0.7-1.2; try 0.9 for a clearly calmer read
TTS_STABILITY=0.3                   # 0-1; lower = more varied/emotional
TTS_STYLE=0.45                      # 0-1; higher = more dramatic

# Bedrock (used when LLM_PROVIDER=bedrock)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=ap-south-1
